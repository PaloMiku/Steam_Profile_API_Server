# Steam Profile API - 环境变量配置
#
# 复制本文件为 .env 后按需填写。除 STEAM_API_KEY 和 STEAM_USER_ID 外全部可选，
# 留空即使用代码里的默认值。本地开发由 server.ts 自动加载根目录 .env；
# Vercel / Netlify / Cloudflare 需要在各自控制台配置同名变量。

# ============================================================================
# 必需配置
# ============================================================================

# [必需] Steam Web API 密钥 - 从 https://steamcommunity.com/dev/apikey 获取
STEAM_API_KEY=your_steam_api_key_here

# [必需] Steam 用户 ID - 你自己的 SteamID64，必须是 17 位纯数字
# 查询方式: https://steamid.io/ 或访问你的 Steam 个人资料页面
# 校验位置: lib/handler.ts 的 validateEnvironment()，正则 /^\d{17}$/
# 位数不对会被直接拒绝，接口返回 500 STEAM ID must be a 17-digit number
STEAM_USER_ID=76561198xxxxxxxxx

# ============================================================================
# 鉴权配置 (可选)
# ============================================================================

# 管理操作令牌 - 用于 clear_cache=true 这类会改动服务端缓存的请求
# 不设置时保持未鉴权（任何人都能清缓存），生产环境建议务必设置
# 传参方式（lib/app.ts 的 authorizeAdmin）:
#   Authorization: Bearer <token>  请求头（推荐）
#   ?admin_token=<token>          查询参数（回退，仅在没带请求头时才读）
# 优先用请求头的原因: 查询参数会进入 CDN 缓存键和访问日志，请求头不会
ADMIN_TOKEN=

# ============================================================================
# 缓存配置 (可选)
# ============================================================================

# 下列三个值影响服务端内存缓存的过期时间，读取自 lib/handler.ts 的 getCacheTTL()
# 同时也是响应头 Cache-Control 里 s-maxage 的来源
# 留空或填非法值时会回退到注释里标注的默认值

# 用户信息缓存时间 (单位: 分钟)
# 默认: 10
CACHE_TTL_USER_MINUTES=10

# 游戏列表缓存时间 (单位: 小时)
# 默认: 24
CACHE_TTL_GAMES_HOURS=24

# 成就信息缓存时间 (单位: 小时)
# 默认: 1
CACHE_TTL_ACHIEVEMENTS_HOURS=1

# ============================================================================
# 性能配置 (可选)
# ============================================================================

# 批量拉取成就时同时进行的请求数上限，读取自 lib/pool.ts
# 只影响 steam-games 这类需要逐个游戏拉取成就的端点
# 默认: 16
# 实测 140 游戏规模的库，并发 16 未出现 Steam 429 限流或超时；
# 调高会更快，但超过某个值会开始触发 Steam 速率限制，不建议盲目调高
# 非法值（0 / 负数 / 非数字）会回退到默认值 16
STEAM_CONCURRENCY=16

# ============================================================================
# 语言配置 (可选)
# ============================================================================

# Steam 商店接口返回内容的语言（游戏名、成就名等），读取自 lib/steam-api.ts
# 常用值: english / schinese / tchinese / japanese / koreana / french / german
# 也可以填别名: en / zh / zh-cn / zh-tw / ja / de / fr / es / ru / ko / pt
# 留空时使用代码内置默认值 schinese（简体中文），与 Steam 账号语言无关
# 别名 STEAM_LANG 同样有效，但 STEAM_LANGUAGE 优先
# 填了映射表以外的值会原样传给 Steam，由 Steam 自行决定
STEAM_LANGUAGE=

# ============================================================================
# 游戏配置
# ============================================================================

# 游戏数量由查询参数 ?limit= 控制，不是环境变量：默认 50，最大 100，越界会回退到 50
# 最近游玩游戏列表数量是由 Steam API 决定的（最近两周内玩过的游戏）
# 无法配置，API 会返回 Steam 统计的实际数量

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别 (debug | info | warn | error)，读取自 lib/utils.ts 的 Logger
# 注意这不是标准的分级过滤：warn 和 error 无论填什么都照常输出，
# 只有 Logger.log 会被过滤 —— LOG_LEVEL 为 debug 或 info 时输出，填其他值则静默
# - debug: 额外输出 Logger.debug 的调试日志，同时输出常规日志（排查问题时用）
# - info:  输出常规日志（默认，生产环境用这个）
# - warn / error: 两者行为相同，只保留 warn 和 error 级别输出
# 默认: info
LOG_LEVEL=info

# ============================================================================
# 服务配置
# ============================================================================

# 服务端口（仅本地 Express 服务器 server.ts 使用；Vercel/Netlify 会注入自己的 PORT）
# 端口被占用时 server.ts 会自动改用随机端口
# 默认: 4000
PORT=4000

# 运行环境 (development | production)
# 项目代码不读取这个变量，保留仅为兼容 Node / 平台的通用约定；
# 部署平台上建议直接用平台的环境设置控制，不要指望它影响本项目行为
# NODE_ENV=production

# ============================================================================
# 以下配置当前实现未读取，仅作为预留项保留，配了不会有任何效果
# ============================================================================

# CORS 允许的源。响应头在 lib/app.ts 的 CORS_HEADERS 里静态写死为 *
# CORS_ORIGIN=*

# 速率限制。代码里没有任何限流逻辑
# ENABLE_RATE_LIMIT=false
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_REQUESTS=100

# 缓存过期检查间隔 (单位: 分钟)。没有后台清理定时器，缓存靠读取时惰性过期
# CACHE_CLEANUP_INTERVAL=5
