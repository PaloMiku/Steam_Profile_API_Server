{
  "name": "steam-profile-api",
  "version": "1.0.0",
  "description": "Serverless API to fetch Steam user profile information including games and achievements with image URLs",
  "main": "server.ts",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "tsc -p tsconfig.check.json",
    "build:platforms": "tsc -p tsconfig.check.json",
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "steam",
    "api",
    "vercel",
    "netlify",
    "serverless",
    "games",
    "achievements"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
